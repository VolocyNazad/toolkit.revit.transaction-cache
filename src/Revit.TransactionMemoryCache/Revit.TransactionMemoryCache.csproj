<Project Sdk="VolocyNazad.Revit.Sdk/1.0.44">

	<PropertyGroup>
		<GeneratePackageOnBuild>true</GeneratePackageOnBuild>
	</PropertyGroup>

	<PropertyGroup>
		<Authors>VolocyNazad</Authors>
		<NeutralLanguage>en-US</NeutralLanguage>
		<Copyright>Copyright © VolocyNazad</Copyright>
		<Description>Revit transaction cache management.</Description>
		<PackageTags>autodesk;revit;api;cache;transaction;</PackageTags>
		<PackageId>VolocyNazad.Revit.TransactionMemoryCache</PackageId>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageType>Dependency</PackageType>
		<!--<PackageIcon>logo_128x128.png</PackageIcon>-->
		<PackageProjectUrl>https://github.com/VolocyNazad/toolkit.revit.transaction-cache</PackageProjectUrl>
		<PackageLicenseFile>LICENSE.md</PackageLicenseFile>
		<PackageOutputPath>..\..\artifacts\</PackageOutputPath>
		<RepositoryType>git</RepositoryType>
		<RepositoryUrl>https://github.com/VolocyNazad/toolkit.revit.transaction-cache</RepositoryUrl>
		<PackageReleaseNotes>https://github.com/VolocyNazad/toolkit.revit.transaction-cache/blob/main/CHANGELOG.md</PackageReleaseNotes>
		<!--<IncludeSymbols>true</IncludeSymbols>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>-->
	</PropertyGroup>

	<ItemGroup>
		<!--<None Include="..\..\.nuget\PackageIcon.png" PackagePath="images/" Pack="true" Visible="false"/>-->
		<None Include="..\..\README.md" Pack="true" PackagePath="" Visible="false" />
		<None Include="..\..\LICENSE.md" Pack="true" PackagePath="" Visible="false" />
	</ItemGroup>

	<PropertyGroup>
		<UseWPF>true</UseWPF>
		<Configurations>
			Debug_2021.1.4;Debug_2021.1.9;Debug_2023.0.0;Debug_2025.0.0;
			Release_2011.0.0;Release_2011.0.1;Release_2012.0.0;Release_2012.0.1;
			Release_2013.0.0;Release_2013.0.1;Release_2014.0.0;Release_2014.0.1;
			Release_2015.0.0;Release_2015.0.1;Release_2016.0.0;Release_2016.0.1;
			Release_2016.0.2;Release_2017.0.0;Release_2017.0.1;Release_2017.0.2;
			Release_2018.0.0;Release_2018.0.1;Release_2018.0.2;Release_2019.0.0;
			Release_2019.0.1;Release_2020.0.0;Release_2020.0.1;Release_2021.0.0;
			Release_2021.1.4;Release_2021.1.9;Release_2022.0.0;Release_2022.1.0;
			Release_2023.0.0;Release_2024.0.0;Release_2024.2.0;Release_2025.0.0;
			Release_2026.0.0;Release_2027.0.0;Release_2027.0.2
		</Configurations>
	</PropertyGroup>

	<!--
		MinVer вычисляет minor.patch по git-тегам/истории коммитов, major всегда берётся из MajorRevitVersion (задаётся SDK из конфигурации).
		Если HEAD не совпадает с тегом, MinVer сам увеличивает patch и добавляет суффикс "dev.<кол-во коммитов после тега>",
		например: тег "0.0.6" + 4 коммита после него -> patch=7, MinVerPreRelease="dev.4".
	-->
	<PropertyGroup>
		<MinVerTagPrefix></MinVerTagPrefix>
		<MinVerMinimumMajorMinor>0.0</MinVerMinimumMajorMinor>
		<MinVerDefaultPreReleaseIdentifiers>dev</MinVerDefaultPreReleaseIdentifiers>
	</PropertyGroup>

	<Target Name="ApplyRevitVersion" AfterTargets="MinVer" BeforeTargets="GetAssemblyVersion;GenerateNuspec;CoreCompile">
		<PropertyGroup>
			<!-- AssemblyVersion/FileVersion — только числа (System.Version не поддерживает суффиксы) -->
			<AssemblyVersion>$(MajorRevitVersion).0.$(MinVerPatch)</AssemblyVersion>
			<FileVersion>$(MajorRevitVersion).0.$(MinVerPatch)</FileVersion>

			<!-- Version/PackageVersion — с суффиксом "-dev.N", если сборка не из коммита с тегом -->
			<Version Condition="'$(MinVerPreRelease)' == ''">$(MajorRevitVersion).0.$(MinVerPatch)</Version>
			<Version Condition="'$(MinVerPreRelease)' != ''">$(MajorRevitVersion).0.$(MinVerPatch)-$(MinVerPreRelease)</Version>
			<PackageVersion>$(Version)</PackageVersion>
		</PropertyGroup>
	</Target>

	<ItemGroup>
		<ProjectReference Include="..\..\analyzers\Revit.TransactionMemoryCache.Analyzers\Revit.TransactionMemoryCache.Analyzers.csproj"
		                   OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
		<ProjectReference Include="..\..\analyzers\Revit.TransactionMemoryCache.Analyzers.CodeFixes\Revit.TransactionMemoryCache.Analyzers.CodeFixes.csproj"
		                   OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Extensions.Caching.Memory" Version="10.0.9" />
		<PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.9" />
		<PackageReference Include="PolySharp" Version="1.16.0">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<PackageReference Include="AutoConstructor" Version="5.6.0">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<PackageReference Include="Revit_All_Main_Versions_API_x64" Version="$(RevitVersion)" />
		<PackageReference Include="VolocyNazad.Revit.Context" Version="$(MajorRevitVersion).0.8" />
		<PackageReference Include="MinVer" Version="7.0.0">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
	</ItemGroup>

</Project>
