<Project Sdk="VolocyNazad.Revit.Sdk/1.1.0">

	<PropertyGroup>
		<GeneratePackageOnBuild>true</GeneratePackageOnBuild>
	</PropertyGroup>

	<PropertyGroup>
		<Authors>VolocyNazad</Authors>
		<NeutralLanguage>en-US</NeutralLanguage>
		<Copyright>Copyright © VolocyNazad</Copyright>
		<Description>Revit transaction cache management.</Description>
		<PackageTags>autodesk;revit;api;cache;transaction;</PackageTags>
		<PackageId>VolocyNazad.Revit.TransactionMemoryCache</PackageId>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageType>Dependency</PackageType>
		<!--<PackageIcon>logo_128x128.png</PackageIcon>-->
		<PackageProjectUrl>https://github.com/VolocyNazad/toolkit.revit.transaction-cache</PackageProjectUrl>
		<PackageLicenseFile>LICENSE.md</PackageLicenseFile>
		<PackageOutputPath>..\..\artifacts\</PackageOutputPath>
		<RepositoryType>git</RepositoryType>
		<RepositoryUrl>https://github.com/VolocyNazad/toolkit.revit.transaction-cache</RepositoryUrl>
		<PackageReleaseNotes>https://github.com/VolocyNazad/toolkit.revit.transaction-cache/blob/main/CHANGELOG.md</PackageReleaseNotes>
		<!--<IncludeSymbols>true</IncludeSymbols>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>-->
	</PropertyGroup>

	<ItemGroup>
		<!--<None Include="..\..\.nuget\PackageIcon.png" PackagePath="images/" Pack="true" Visible="false"/>-->
		<None Include="..\..\README.md" Pack="true" PackagePath="" Visible="false" />
		<None Include="..\..\LICENSE.md" Pack="true" PackagePath="" Visible="false" />
	</ItemGroup>

	<PropertyGroup>
		<UseWPF>true</UseWPF>
		<Configurations>
		  Debug_2021.1.100;Debug_2022.1.80;Debug_2023.1.90;Debug_2024.3.60;Debug_2025.4.60;Debug_2026.4.10;Debug_2027.3.0;
		  Release_2021.1.100;Release_2022.1.80;Release_2023.1.90;Release_2024.3.60;Release_2025.4.60;Release_2026.4.10;Release_2027.3.0
		</Configurations>
	</PropertyGroup>

	<!--
		MinVer computes minor.patch from git tags/commit history; major always comes from MajorRevitVersion (set by the SDK from the configuration).
		If HEAD does not match a tag, MinVer increments patch itself and appends a "dev.<number of commits since the tag>" suffix,
		e.g.: tag "0.0.6" + 4 commits after it -> patch=7, MinVerPreRelease="dev.4".
	-->
	<PropertyGroup>
		<MinVerTagPrefix></MinVerTagPrefix>
		<MinVerMinimumMajorMinor>0.0</MinVerMinimumMajorMinor>
		<MinVerDefaultPreReleaseIdentifiers>dev</MinVerDefaultPreReleaseIdentifiers>
	</PropertyGroup>

	<Target Name="ApplyRevitVersion" AfterTargets="MinVer" BeforeTargets="GetAssemblyVersion;GenerateNuspec;CoreCompile">
		<PropertyGroup>
			<!-- AssemblyVersion/FileVersion — numbers only (System.Version does not support suffixes) -->
			<AssemblyVersion>$(MajorRevitVersion).0.$(MinVerPatch)</AssemblyVersion>
			<FileVersion>$(MajorRevitVersion).0.$(MinVerPatch)</FileVersion>

			<!-- Version/PackageVersion — with a "-dev.N" suffix if the build is not from a tagged commit -->
			<Version Condition="'$(MinVerPreRelease)' == ''">$(MajorRevitVersion).0.$(MinVerPatch)</Version>
			<Version Condition="'$(MinVerPreRelease)' != ''">$(MajorRevitVersion).0.$(MinVerPatch)-$(MinVerPreRelease)</Version>
			<PackageVersion>$(Version)</PackageVersion>
		</PropertyGroup>
	</Target>

	<ItemGroup>
		<ProjectReference Include="..\..\analyzers\Revit.TransactionMemoryCache.Analyzers\Revit.TransactionMemoryCache.Analyzers.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
		<ProjectReference Include="..\..\analyzers\Revit.TransactionMemoryCache.Analyzers.CodeFixes\Revit.TransactionMemoryCache.Analyzers.CodeFixes.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Extensions.Caching.Memory" />
		<PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
		<PackageReference Include="PolySharp">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<PackageReference Include="AutoConstructor">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<PackageReference Include="Nice3point.Revit.Api.RevitAPI" />
		<PackageReference Include="Nice3point.Revit.Api.RevitAPIUI" />
		<PackageReference Include="VolocyNazad.Revit.Context" />
	</ItemGroup>

</Project>
