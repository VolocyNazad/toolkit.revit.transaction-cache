<Project Sdk="VolocyNazad.Revit.Sdk/1.1.0">
	<PropertyGroup>
		<Platform>x64</Platform>
		<OutputType>Exe</OutputType>
		<IsPackable>false</IsPackable>
		<IsTestProject>true</IsTestProject>
		<GenerateDocumentationFile>false</GenerateDocumentationFile>
		<NoWarn>CS1591</NoWarn>
	</PropertyGroup>
	<PropertyGroup>
		<Configurations>
		  Debug_2021.1.100;Debug_2022.1.80;Debug_2023.1.90;Debug_2024.3.60;Debug_2025.4.60;Debug_2026.4.10;Debug_2027.3.0;
		  Release_2021.1.100;Release_2022.1.80;Release_2023.1.90;Release_2024.3.60;Release_2025.4.60;Release_2026.4.10;Release_2027.3.0
		</Configurations>
	</PropertyGroup>
	<ItemGroup>
		<PackageReference Include="Nice3point.TUnit.Revit" Version="$(MajorRevitVersion).*" />
		<!--
			Needed on net48-era target frameworks: TUnit's source generator emits a
			[ModuleInitializer]-attributed method into THIS project, so this project needs its own
			PolySharp-generated (internal, per-assembly) ModuleInitializerAttribute polyfill - it can't
			reuse the one Revit.TransactionMemoryCache.csproj generates for itself via ProjectReference,
			that one is internal to that assembly and inaccessible here (CS0122).
		-->
		<PackageReference Include="PolySharp" Version="1.16.0">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
	</ItemGroup>
	<ItemGroup>
		<ProjectReference Include="..\..\src\Revit.TransactionMemoryCache\Revit.TransactionMemoryCache.csproj" />
	</ItemGroup>
</Project>
